# ─────────────────────────────────────────────
# Variables de entorno — Sistema de Control de Gastos
# Copiar este archivo como .env y ajustar los valores.
# ─────────────────────────────────────────────

# ── Base de datos PostgreSQL ──
DATABASE_URL=postgresql://postgres:secret_password@localhost:5432/expense_db

# ── Autenticación JWT ──
JWT_SECRET=cambiar_por_un_secreto_seguro_aleatorio

# ── Puerto del backend ──
PORT=3000
